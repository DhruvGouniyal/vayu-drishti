# Copy to .env and fill in. Never commit .env.

# NASA FIRMS MAP_KEY (free, instant): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_key_here

# OpenAQ v3 API key (free account): https://explore.openaq.org/register
OPENAQ_API_KEY=your_key_here

# data.gov.in API key (free account; live AQI fallback when OpenAQ lags):
# https://www.data.gov.in/ -> Sign up / Login -> My Account -> Generate API key
DATA_GOV_IN_API_KEY=your_key_here

# Optional: pin OpenAQ location ids if auto-discovery picks the wrong station.
# OPENAQ_LOCATION_IDS=sector22=12345,sector25=67890,sector53=13579

# Optional: put data somewhere other than ./data
# VAYU_DATA_DIR=D:/vayu-data
